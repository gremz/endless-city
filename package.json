{
  "name": "3d-game-ow",
  "version": "0.1.0",
  "private": true,
  "description": "Endless procedural city first-person shooter with Counter-Strike style movement and gunplay",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "models:check": "node --import ./scripts/register-ts.mjs scripts/check-models.ts",
    "models:placeholder": "node --import ./scripts/register-ts.mjs scripts/make-placeholder.ts",
    "models:bots": "node --import ./scripts/register-ts.mjs scripts/make-bots.ts",
    "models:player": "node --import ./scripts/register-ts.mjs scripts/make-player.ts",
    "models:reference": "node --import ./scripts/register-ts.mjs scripts/hitbox-reference.ts"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
